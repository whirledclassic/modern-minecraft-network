# Copy this file to .env and edit it.
#   cp .env.example .env

# Must match proxy/forwarding.secret exactly.
# Run ./scripts/new-secret.sh to generate one.
VELOCITY_SECRET=change-me-to-a-long-random-string

# Shown in the multiplayer server list.
MOTD=&b&lModern Network &8| &fLobby + Survival

# Paper / Minecraft version. LATEST tracks current Paper releases.
MC_VERSION=LATEST

# Heap sizes. Tune to your machine.
PROXY_MEMORY=512M
LOBBY_MEMORY=2G
SURVIVAL_MEMORY=4G

# Public max-players shown in the server list (not a hard performance cap).
MAX_PLAYERS=60
